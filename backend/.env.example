# API Keys
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_gpt_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/matrix_bridge
VECTOR_DB_URL=weaviate://localhost:8080

# Server
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your_secret_key_here

# Frontend
REACT_APP_API_URL=http://localhost:8000

# Outlook integration (Microsoft Graph, delegated, read-only)
# Entra app registration: Public client, "Allow public client flows" = Yes
# Delegated permissions: Calendars.Read, Mail.Read, User.Read
OUTLOOK_TENANT_ID=organizations
OUTLOOK_CLIENT_ID=
OUTLOOK_STATE_DIR=.outlook-state
OUTLOOK_MAIL_FOLDERS=inbox,sentitems,drafts
OUTLOOK_CALENDAR_LOOKBACK_DAYS=30
OUTLOOK_CALENDAR_LOOKAHEAD_DAYS=14
# Domains that count as "us". Anything else is an external contact.
OUTLOOK_INTERNAL_DOMAINS=yourcompany.com
# Comma-separated words. Any event or email containing one never leaves the process.
OUTLOOK_PERSONAL_KEYWORDS=
OUTLOOK_STALE_AFTER_DAYS=3
# Optional webhooks. Public HTTPS URL ending in /api/outlook/notifications and a random string (max 128 chars).
OUTLOOK_NOTIFICATION_URL=
OUTLOOK_CLIENT_STATE=
